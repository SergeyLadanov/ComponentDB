{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "WEB: Install npm dependencies",
      "type": "shell",
      "command": "npm",
      "args": [
        "ci",
        "--no-audit",
        "--no-fund"
      ],
      "options": {
        "cwd": "${workspaceFolder}/react"
      },
      "problemMatcher": []
    },
    {
      "label": "WEB: Build",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/react"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
